flowchart TB
    A["Windows PC 프로그램 실행"] --> B["GUI 초기화"]
    B --> C["라즈베리 파이 RTSP 주소 설정"]
    C --> D["RTSP 스트림 연결"]
    D --> E{"영상 수신 성공?"}
    E -- 실패 --> F["연결 실패 상태 표시"]
    F --> G["RTSP 재연결 시도"]
    G --> D
    E -- 성공 --> H["OpenCV로 프레임 읽기"]
    H --> I["YOLO 객체 탐지"]
    I --> J["객체 상태 분석"]
    J --> K{"이상 상황 또는 이벤트 발생?"}
    K -- 아니오 --> L["GUI에 실시간 영상 표시"]
    K -- 예 --> M["이벤트 정보 생성"]
    M --> O["Discord 알림 전송"] & P["이벤트 이미지와 짧은 클립 저장"]
    L --> H & Q{"사용자가 프로그램 종료?"}
    O --> L
    P --> L
    Q -- 아니오 --> H
    Q -- 예 --> R["RTSP 연결 해제"]
    R --> S["프로그램 종료"]